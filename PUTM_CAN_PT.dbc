// ============================================================================
// COMMENTS - Message Descriptions
// ============================================================================

CM_ "AMK Racing Kit 4WD - Complete CAN Communication";
CM_ "Fixed CAN Message Configuration - Intel (Little Endian) format";
CM_ "Based on AMK Documentation PDK_205481_KW26-S5-FSE-4Q Version 2020/44";

CM_ BO_ 387 "Rear Left Setpoints: Control commands from PC to inverter";
CM_ BO_ 642 "Rear Left Actual Values 1: Status word and realtime feedback";
CM_ BO_ 643 "Rear Left Actual Values 2: Temperature monitoring and diagnostics";

CM_ BO_ 388 "Rear Right Setpoints: Control commands from PC to inverter";
CM_ BO_ 644 "Rear Right Actual Values 1: Status word and realtime feedback";
CM_ BO_ 645 "Rear Right Actual Values 2: Temperature monitoring and diagnostics";

CM_ BO_ 389 "Front Right Setpoints: Control commands from PC to inverter";
CM_ BO_ 646 "Front Right Actual Values 1: Status word and realtime feedback";
CM_ BO_ 647 "Front Right Actual Values 2: Temperature monitoring and diagnostics";

CM_ BO_ 390 "Front Left Setpoints: Control commands from PC to inverter";
CM_ BO_ 648 "Front Left Actual Values 1: Status word and realtime feedback";
CM_ BO_ 649 "Front Left Actual Values 2: Temperature monitoring and diagnostics";

// ============================================================================
// COMMENTS - Signal Descriptions
// ============================================================================

CM_ SG_ 387 AMK_bInverterOn "Controller enable command";
CM_ SG_ 387 AMK_bDcOn "HV DC-link activation command";
CM_ SG_ 387 AMK_bEnable "Driver enable command";
CM_ SG_ 387 AMK_bErrorReset "Error reset command (all setpoints must be 0)";
CM_ SG_ 387 AMK_TargetVelocity "Target motor speed setpoint";
CM_ SG_ 387 AMK_TorqueLimitPositive "Positive torque limit in 0.1% of nominal torque (1000 = 100%)";
CM_ SG_ 387 AMK_TorqueLimitNegative "Negative torque limit in 0.1% of nominal torque (-1000 = -100%)";

CM_ SG_ 642 AMK_bSystemReady "System ready status (SBM)";
CM_ SG_ 642 AMK_bError "Error status flag";
CM_ SG_ 642 AMK_bWarn "Warning status flag";
CM_ SG_ 642 AMK_bQuitDcOn "HV DC-link activation acknowledgment";
CM_ SG_ 642 AMK_bDcOn "HV DC-link activation status";
CM_ SG_ 642 AMK_bQuitInverterOn "Controller enable acknowledgment";
CM_ SG_ 642 AMK_bInverterOn "Controller enable status";
CM_ SG_ 642 AMK_bDerating "Derating active (torque limitation in effect)";
CM_ SG_ 642 AMK_ActualVelocity "Actual motor speed";
CM_ SG_ 642 AMK_TorqueCurrent "Raw torque-producing current Iq. Convert: Iq[A] = raw * IMax / 32767";
CM_ SG_ 642 AMK_MagnetizingCurrent "Raw magnetizing current Id for field weakening. Convert: Id[A] = raw * IMax / 32767";

CM_ SG_ 643 AMK_TempMotor "Motor winding temperature";
CM_ SG_ 643 AMK_TempInverter "Inverter cold plate temperature";
CM_ SG_ 643 AMK_ErrorInfo "Diagnostic error code number";
CM_ SG_ 643 AMK_TempIGBT "IGBT power module temperature";

// ============================================================================
// ATTRIBUTES
// ============================================================================

BA_DEF_ BO_ "GenMsgCycleTime" INT 0 65535;
BA_DEF_ SG_ "GenSigStartValue" FLOAT 0 10000;

// Cycle time: 5ms for all messages (AMK default)
BA_ "GenMsgCycleTime" BO_ 387 5;
BA_ "GenMsgCycleTime" BO_ 642 5;
BA_ "GenMsgCycleTime" BO_ 643 5;
BA_ "GenMsgCycleTime" BO_ 388 5;
