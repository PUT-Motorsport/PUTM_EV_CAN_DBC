BA_ "GenMsgCycleTime" BO_ 390 5;
BA_ "GenMsgCycleTime" BO_ 648 5;
BA_ "GenMsgCycleTime" BO_ 649 5;

// Start values for torque limits (100% = 1000)
BA_ "GenSigStartValue" SG_ 387 AMK_TorqueLimitPositive 1000;
BA_ "GenSigStartValue" SG_ 388 AMK_TorqueLimitPositive 1000;
BA_ "GenSigStartValue" SG_ 389 AMK_TorqueLimitPositive 1000;
BA_ "GenSigStartValue" SG_ 390 AMK_TorqueLimitPositive 1000;

BA_ "GenSigStartValue" SG_ 387 AMK_TorqueLimitNegative -1000;
BA_ "GenSigStartValue" SG_ 388 AMK_TorqueLimitNegative -1000;
BA_ "GenSigStartValue" SG_ 389 AMK_TorqueLimitNegative -1000;
BA_ "GenSigStartValue" SG_ 390 AMK_TorqueLimitNegative -1000;

